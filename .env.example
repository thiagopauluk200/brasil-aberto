PORT=3001
HOST=127.0.0.1
# Publicação: HOST=0.0.0.0; use PORT fornecido pela hospedagem.
# No Render, defina TRUST_PROXY=1. Localmente, deixe vazio.
TRUST_PROXY=
# Origem do frontend publicado, sem /nome-do-repositorio e sem barra final.
# Exemplo: https://seu-usuario.github.io
ALLOWED_ORIGINS=
# Opcional localmente. No GitHub Actions, crie como variável do repositório.
# URL pública do backend, sem /api. Nunca coloque uma chave neste campo.
VITE_API_BASE_URL=
# O workflow do Pages preenche este caminho automaticamente.
VITE_BASE_PATH=/
# Opcional. Obtenha em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Nunca utilize prefixo VITE_ para credenciais.
TRANSPARENCIA_API_KEY=
